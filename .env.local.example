# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_PRICE_SHOWCASE=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SCOUT=price_...
STRIPE_PRICE_ORG=price_...

# Anthropic (server-side only, never exposed to the client)
# Used by the /api/ai/* routes. Do not prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# On-demand cache invalidation. The seed scripts POST here so a reseed shows up
# immediately instead of waiting out the colleges cache.
REVALIDATE_SECRET=generate-a-long-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Lead notifications (Phase 2)
# Resend: server-side only. With no key set, sends become logged dry runs.
RESEND_API_KEY=re_...
# Must be an address on the domain verified in Resend.
RESEND_FROM="RPM Recruit <notify@send.athlyticz.com>"
# Where lead emails and the waitlist digest land.
NOTIFY_EMAIL=michael@athlyticz.com
# Shared secret between the pg_net trigger (notify_config) and /api/notify/lead.
NOTIFY_WEBHOOK_SECRET=generate-a-long-random-string
# Vercel sends this as a bearer token with cron requests to the digest route.
CRON_SECRET=generate-another-long-random-string

