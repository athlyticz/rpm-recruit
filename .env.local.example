# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
STRIPE_PRICE_SHOWCASE=price_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SCOUT=price_...
STRIPE_PRICE_ORG=price_...

# Anthropic (server-side only, never exposed to the client)
# Used by the /api/ai/* routes. Do not prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# On-demand cache invalidation. The seed scripts POST here so a reseed shows up
# immediately instead of waiting out the colleges cache.
REVALIDATE_SECRET=generate-a-long-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
